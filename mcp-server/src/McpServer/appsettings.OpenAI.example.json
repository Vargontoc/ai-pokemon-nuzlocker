{
  "ConnectionStrings": {
    "Database": "Data Source=pokecache.db"
  },
  "PokeApi": {
    "BaseUrl": "https://pokeapi.co/api/v2",
    "TimeoutSeconds": 30
  },
  "AiProvider": {
    "Provider": "OpenAI",
    "ApiKey": "sk-proj-YOUR_OPENAI_API_KEY_HERE",
    "Model": "gpt-4o",
    "MaxTokens": 2048,
    "Temperature": 0.7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
