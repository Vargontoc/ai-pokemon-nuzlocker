{
  "ConnectionStrings": {
    "Database": "Data Source=pokecache.db"
  },
  "PokeApi": {
    "BaseUrl": "https://pokeapi.co/api/v2",
    "TimeoutSeconds": 30,
    "MemoryCacheTtlMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
